---
import "../global.css"
import { SEO } from 'astro-seo';
import FooterNew from '../components/FooterNew.astro';
import NavbarNew from '../components/NavbarNew.astro';
import { getAPIPath, getImageBasePath } from '../data/utils';

//Fetching Site Settings
const allSiteFetch:any = await fetch(getAPIPath() + "siteSettings/" + import.meta.env.SITESETTINGSKEY).then(Response => Response.json());

interface Props {
    title : string,
    metaDescription ?: string,
    lang ?: string,
    translations ?:any,
    havePadding ?: boolean,
    pageType ?: string
    pageFeaturedImage ?: string
}

const {
    title, 
    lang = "en", 
    translations,
    metaDescription = allSiteFetch.siteData.SiteMetaDescription,
    havePadding = true,
    pageType = "website",
    pageFeaturedImage = "string"
} = Astro.props;

---

<!DOCTYPE html>
<html lang={lang} class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="shortcut icon" href={getImageBasePath() + allSiteFetch.siteData.faviconImage} type="image/x-icon">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.3.0/css/all.min.css">
    <meta name="generator" content={Astro.generator} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <SEO
      title={title}
      description={metaDescription}
      openGraph={{
        basic: {
          title: `${title} - ${allSiteFetch.siteData.SiteTitle}`,
          type: pageType,
          image: pageFeaturedImage,
        }
      }}
      twitter={{
        creator: "@Jack"
      }}
      extend={{
        // extending the default link tags{allSiteFetch.siteFavicon}
        link: [{ rel: "icon", href: getImageBasePath() + allSiteFetch.siteData.faviconImage }],
        // extending the default meta tags
        meta: [
          {
            name: "twitter:image",
            content: pageFeaturedImage,
          },
          { name: "twitter:title", content: `${title} - ${allSiteFetch.siteData.SiteTitle}` },
          { name: "twitter:description", content: metaDescription },
        ],
      }}
    />
    
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" />
	  <script is:inline src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-element-bundle.min.js"></script>
</head>
<body>
  <div class="bgContainer fixed top-0 left-0 bg-cover bg-no-repeat h-screen w-full overflow-hidden" style=`background-image: url('${getImageBasePath() + allSiteFetch.siteData.SiteBGImage}');`>
    <div class="overlay z-0 absolute size-full bg-[#0000006f]"></div>
  </div>
    <div class="main-container">
        
        <div class="content-container h-full relative z-[1]">
            <NavbarNew {lang} {translations} logoImgSrc={getImageBasePath() + allSiteFetch.siteData.logoImage} siteTitle={allSiteFetch.siteData.SiteTitle} navData={allSiteFetch.navbarData}/>

            <main class="w-full backdrop-blur-2xl lg:min-h-[60vh] lg:overflow-x-hidden" class:list={[
                havePadding && "p-4"
            ]}>
                <slot />
            </main>

            <FooterNew {lang} logoImgSrc={getImageBasePath() + allSiteFetch.siteData.logoImage} siteTitle={allSiteFetch.siteData.SiteTitle}/>
        </div>
    </div>

    <script is:inline>
      console.log("This website is developed by Bishal Biswas. https://bishalbiswas.dev/")
    </script>
</body>
</html>
---

interface Props {
    imageSrc : string,
    panelTitle : string,
    slugURL : string,
    lang ?: string,
}

const {imageSrc ,panelTitle, slugURL, lang="en"} = Astro.props;
let langDirectory = "";
if(lang != "en"){
    langDirectory = "/"+ lang
}
// console.log(imageSrc ,panelTitle ,descriptionText ,slugURL);

---
<style is:inline>
    /* article:hover img{
        filter: brightness(.75);
    } */
    article:hover .data{
        transform: translateY(0);
    }
</style>

<article class="lg:w-[32%] md:w-[48%] overflow-hidden relative w-full rounded-lg shadow-sm hover:shadow-2xl hover:-translate-y-2 hover:scale-105 transition-all ease-in-out duration-150">
        
    <a class="relative flex justify-center items-center" href={langDirectory + "/panels/" + slugURL}>
        <img src=
        {
            imageSrc != ""
            ? imageSrc 
            :"/assets/images/no-image-available.jpg"
        } 
        alt={panelTitle + " thumbnail"} class="h-64 w-full rounded-t-lg">

    </a>
    
    <div class="data w-full rounded-b-lg text-white p-4 bg-[#00000069] backdrop-blur-sm bottom-0 left-0 transition-all ease-in-out duration-150">
        <h2 class="font-bold text-center">
            <a class="hover:underline" href={langDirectory + "/panels/" + slugURL}>{panelTitle}</a> 
            <span class="inline-flex justify-center items-center size-5 rounded-full text-white bg-sky-500 shadow-lg shadow-blue-400">
                <i class="fa-solid fa-angle-right"></i>
            </span>
        </h2>
    </div>
</article>

---
import { getRelativeLocaleUrl } from 'astro:i18n';

import { getAPIPath } from '../data/utils';
import GlassLayout from './GlassLayout.astro'
import { metaDataEs, metaDataPt } from '../data/translations';

interface Props {
    siteTitle : string
    logoImgSrc :string,
    lang ?:string,
}
const {lang="en", logoImgSrc="", siteTitle} = Astro.props

let contentPath : {
    language: string;
    text: string[];
} = {
    language : "",
    text : []
};

if(lang == "es")
    contentPath = metaDataEs;
else if((lang == "pt"))
    contentPath = metaDataPt;

const Links = [
    { title: lang == "en" ? "About Us" :contentPath?.text[12] , url: getRelativeLocaleUrl(lang,`/page/about`)},
    { title: lang == "en" ? "Privacy Policy" :contentPath?.text[13] , url: getRelativeLocaleUrl(lang,`/page/privacy-policy`) },
    { title: lang == "en" ? "Disclaimer" :contentPath?.text[14],  url: getRelativeLocaleUrl(lang,`/page/disclaimer`)},
    { title: lang == "en" ? "Contact Us" :contentPath?.text[15] , url: getRelativeLocaleUrl(lang,`/page/contact`)},
]

const allSiteFetch:any = await fetch(getAPIPath() + "siteSettings/" + import.meta.env.SITESETTINGSKEY).then(Response => Response.json());

let footerTextBasedOnLang;
if(lang == "es") footerTextBasedOnLang = allSiteFetch.footerData.footerTextEs;
else if(lang == "pt") footerTextBasedOnLang = allSiteFetch.footerData.footerTextPt;
else footerTextBasedOnLang = allSiteFetch.footerData.footerCopyrightText;
---

<GlassLayout otherClass='m-4 p-4'>

    <div class="bottom-content backdrop-blur-sm ">
        
        <div class="Footer-wrapper flex flex-col justify-center items-center">
            <a href="/" class="logo">
                <img src={logoImgSrc} class="h-20" alt="">
            </a>
        </div>

        <footer class="w-full flex flex-col justify-center items-center text-white">

            <nav class="">
                <ul class="flex flex-wrap gap-x-5 gap-y-2 justify-center items-center">
                    {
                        Links.map((link)=>(
                            <li class="cursor-pointer font-semibold hover:text-[#d3d8da]"><a href={link.url}>{link.title}</a></li>
                        ))
                    }
                </ul>
            </nav>

            <div class="main-container">
                <div class="wrapper w-full p-3">
    
                    <div class="bottom flex justify-center items-center">
                        <span class="text-xs text-center">Copyright &copy; {siteTitle} {new Date().getFullYear()} | {footerTextBasedOnLang}</span>
                    </div>
                </div>
            </div>
        </footer>
    </div>
</GlassLayout>
---
interface Props {
    title: string
    link ?: string
    id ?: string
    onclickFunction ?: string,
    iconClass ?: string
    type ?: string
}

const {title, link, onclickFunction, iconClass, id, type="button"} = Astro.props;

---

{   link &&
    <a href={link} {id} class="w-fit px-3 py-1 rounded-full border-white border-2 text-white font-semibold hover:border-blue-500 hover:bg-blue-500 hover:scale-105 transition-all ease-in-out duration-300">{title} <i class="pl-4 fa-solid fa-angle-right"></i></a>
}
{   onclickFunction &&
    <button {id} onclick={onclickFunction} class="w-fit px-3 py-1 rounded-full border-white border-2 text-white font-semibold hover:border-blue-500 hover:bg-blue-500 hover:scale-105 transition-all ease-in-out duration-300 disabled:bg-[#d1d1d1]">{title} <i class={`pl-3 ${iconClass}`}></i></button>
}

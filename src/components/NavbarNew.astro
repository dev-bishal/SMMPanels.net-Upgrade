---
import { metaDataEs } from '../pages/es/data';
import { metaDataPt } from '../pages/pt/data';

interface Props {
    siteTitle :string
    logoImgSrc :string,
    lang ?:string,
    navData : any
}
const {logoImgSrc="", siteTitle, navData} = Astro.props;
let {lang} = Astro.props;

let langDirectory = "";
if(lang != "en"){
    langDirectory = "/"+ lang
}
let contentPath;
if(lang == "es") contentPath = metaDataEs
else if(lang == "pt") contentPath = metaDataPt

---
 <!-- header -->
 <header data-aos="fade-down" data-aos-delay="2500" class="w-full fixed lg:relative z-[4] text-white flex justify-center items-start">
    <div class="wrapper bg-[#aaa4a473] fixed z-[3] p-4 gap-12 px-8 hidden lg:flex justify-between backdrop-blur-sm m-3 rounded-full shadow-2xl">
        <div class="left-sec my-auto">
            <a href="/" class="logo">
                <img src={logoImgSrc} class="h-10" alt={siteTitle}>
            </a>
        </div>
        <div class="middle-sec my-auto">
            <nav>
                <ul class="flex gap-14">
                    {
                        lang == "en" &&
                        navData.navLinks.map((link :any)=>(
                            <li class="cursor-pointer font-semibold hover:text-[#d3d8da]"><a href={link.href}>{link.label}</a></li>
                        ))
                    }
                    {
                        lang == "es" &&
                        navData.navLinksEs.map((link :any)=>(
                            <li class="cursor-pointer font-semibold hover:text-[#d3d8da]"><a href={"/es" + link.href}>{link.label}</a></li>
                        ))
                    }
                    {
                        lang == "pt" &&
                        navData.navLinksPt.map((link :any)=>(
                            <li class="cursor-pointer font-semibold hover:text-[#d3d8da]"><a href={"/pt" + link.href}>{link.label}</a></li>
                        ))
                    }
                </ul>
            </nav>
        </div>
        <div class="right-sec my-auto">
            <nav class="flex items-center gap-4 border-l border-gray-500 pl-4">
                <span class="language-selector relative cursor-pointer bg-gradient-to-tr from-orange-500 to-yellow-400 font-semibold text-purple-900 rounded-full px-5 py-2 shadow-xl">
                    <i class="fa-sharp-duotone fa-solid fa-earth-americas"></i>
                    <span class="uppercase">{lang}</span>
                    <i class="fa-solid fa-angle-down"></i>
            
                    <ul class="absolute z-[2] border-white border top-[40px] right-0 bg-[#aaa4a4c7] backdrop-blur-sm py-2 text-sm w-max opacity-0 invisible rounded-lg text-white transition-all duration-200 ease-in-out">
                        <li class="px-2 py-1 hover:bg-slate-700">(EN) English</li>
                        <li class="px-2 py-1 hover:bg-slate-700">(ES) Spanish</li>
                        <li class="px-2 py-1 hover:bg-slate-700">(PT) Portuguese</li>
                    </ul>
                </span>
                <ul>
                    {
                        navData.rightButtonTitle && 
                        <li>
                            <a href={navData.rightButtonLink} class="block bg-gradient-to-tr from-orange-500 to-yellow-400 font-semibold text-purple-900 rounded-full px-5 py-2 shadow-xl"><i class={navData.rightButtonClasses}></i></a></li>
                    }
                </ul>
            </nav>
        </div>
    </div>

    <div class="mobileHeaderwrapper select-none relative w-full bg-[#6d696973] p-4 px-8 lg:hidden flex justify-between items-center backdrop-blur-sm m-3 rounded-full shadow-2xl">
        <a href="/" class="logo">
            <img src={logoImgSrc} class="h-10" alt={siteTitle}>
        </a>
        <span
            class="navBarHamburger cursor-pointer text-2xl rounded-full w-10 h-10 flex justify-center items-center hover:bg-[rgba(0,0,0,0.21)]">
            <span class="bars"><i class="fa-solid fa-bars"></i></span>
            <span class="xmark hidden"><i class="fa-solid fa-xmark"></i></span>
        </span>

        <nav class="absolute w-full left-0 top-20 p-5 backdrop-blur-md bg-gradient-to-bl from-[#979797] to-[#000000f7] rounded-lg transition-all ease-in-out duration-300 -translate-y-[200%]">  <!-- backdrop-blur-md bg-gradient-to-bl from-orange-700 to-pink-800  -->
            <ul class="flex flex-col gap-4 pb-4">
                {
                    lang == "en" &&
                    navData.navLinks.map((link :any)=>(
                        <li class="w-full"><a class="block w-full" href={link.href}>{link.label}</a></li>
                    ))
                }
                {
                    lang == "es" &&
                    navData.navLinksEs.map((link :any)=>(
                        <li class="w-full"><a class="block w-full" href={"/es/" + link.href}>{link.label}</a></li>
                    ))
                }
                {
                    lang == "pt" &&
                    navData.navLinksPt.map((link :any)=>(
                        <li class="w-full"><a class="block w-full" href={"/pt/" + link.href}>{link.label}</a></li>
                    ))
                }
            </ul>

            <span class="border-t border-gray-500 w-full block py-2"></span>

            <span class="language-selector w-full block relative cursor-pointer bg-gradient-to-tr from-orange-500 to-yellow-400 font-semibold text-purple-900 rounded-full px-5 py-2 shadow-xl">
                <i class="fa-sharp-duotone fa-solid fa-earth-americas"></i>
                <span>Language - {lang?.toLocaleUpperCase()}</span>
                <i class="fa-solid fa-angle-down"></i>
            </span> 
            <ul class="static w-full h-0 p-0 m-0 z-[2] border-white border top-[40px] right-0 bg-[#aaa4a4c7] backdrop-blur-sm text-sm opacity-0 invisible rounded-lg text-white transition-all duration-200 ease-in-out">
                <li class="px-2 py-1 hover:bg-slate-700">(EN) English</li>
                <li class="px-2 py-1 hover:bg-slate-700">(ES) Spanish</li>
                <li class="px-2 py-1 hover:bg-slate-700">(PT) Portuguese</li>
            </ul>
            <ul class="flex flex-col gap-4 pt-4">
                {
                    navData.rightButtonTitle && 
                    <li class="w-full"><a href={navData.rightButtonLink} class="block bg-gradient-to-tr from-orange-500 to-yellow-400 font-semibold text-purple-900 rounded-full px-5 py-2 shadow-xl"><i class={navData.rightButtonClasses}></i> {navData.rightButtonTitle}</a></li>
                }
                
            </ul>
        </nav>
        
    </div>
    <span class="hidden hover:bg-[#ece8e873]"></span>
</header>

<script is:inline>
    //Mobile NavBar
const mobileHamburgerBtn = document.querySelector(".navBarHamburger");
const mobileNavBar = document.querySelector(".mobileHeaderwrapper nav");

function TriggerNavBar() {
    mobileHamburgerBtn.querySelector(".bars").classList.toggle("hidden");
    mobileHamburgerBtn.querySelector(".xmark").classList.toggle("hidden");
    mobileNavBar.classList.toggle("-translate-y-[200%]");
}

mobileHamburgerBtn.addEventListener("click", () => {
    TriggerNavBar()
});

//#region change language

    //Detecting if there is language from the local storage
    let changeLangBtns = document.querySelectorAll('.language-selector');
    let langArray = ["ZH", "RU", "ES", "FR", "HI", "BN", "PT", "UR", "ID"];
    if(localStorage.getItem("lang") == null){
        if(langArray.includes(window.location.pathname.substring(1, 3).toUpperCase()))
            localStorage.setItem("lang", window.location.pathname.substring(1, 3));
        else
            localStorage.setItem("lang", "en");
    }
    //If there is a lang in the Localstorage. Then automatically redirect to language relevant page but not in the case of EN
    else if(localStorage.getItem("lang") != null && localStorage.getItem("lang") != "en"){
        const lang = localStorage.getItem("lang") || "en"; // Default to English if no selection
        const currentPath = window.location.pathname; // Get current path
        const langRegex = /^\/([a-z]{2})\//; // Regex to detect language in URL
        
        const match = currentPath.match(langRegex);
        const urlLang = match ? match[1] : "en"; // Extracted language or default to "en"
        
        if (urlLang !== lang) {
            let newPath = currentPath.replace(langRegex, "/"); // Remove existing language prefix
            
            // Add language prefix if it's not English
            if (lang !== "en") {
                newPath = `/${lang}${newPath}`;
            }
        
            // Redirect to the correct URL
            window.location.replace(newPath);
        }
    }

    changeLangBtns[0].querySelectorAll('ul li').forEach(li=>{
        if(li.innerHTML.slice(1,3).toLowerCase() == localStorage.getItem("lang")){
            li.classList.add("bg-[#616161]");
            li.classList.add("cursor-no-drop");
        }
    });
    changeLangBtns[1].nextElementSibling.querySelectorAll('ul li').forEach(li=>{
        if(li.innerHTML.slice(1,3).toLowerCase() == localStorage.getItem("lang")){
            li.classList.add("bg-[#616161]");
            li.classList.add("cursor-no-drop");
        }
    });
    
    changeLangBtns[0].addEventListener('click', ()=>{
        changeLangBtns[0].querySelector('ul').classList.toggle('opacity-100');
        changeLangBtns[0].querySelector('ul').classList.toggle('invisible');
    })
    
    changeLangBtns[1].addEventListener('click', ()=>{
        changeLangBtns[1].nextElementSibling.classList.toggle('opacity-100');
        changeLangBtns[1].nextElementSibling.classList.toggle('invisible');
        changeLangBtns[1].nextElementSibling.classList.toggle('h-0');
        changeLangBtns[1].nextElementSibling.classList.toggle('p-0');
        changeLangBtns[1].nextElementSibling.classList.toggle('py-2');
        changeLangBtns[1].nextElementSibling.classList.toggle('m-0');
        changeLangBtns[1].nextElementSibling.classList.toggle('mt-[3px]');
        changeLangBtns[1].nextElementSibling.classList.toggle('mx-auto');
    })

    changeLangBtns[0].querySelectorAll('ul li:not(.cursor-no-drop)').forEach(li=>{
        li.addEventListener('click', ()=>{
            localStorage.setItem('lang', li.innerText.slice(1,3).toLowerCase());
            changeLangBtns[0].querySelector('span').textContent = li.innerText.slice(1,3);

            let currentPath = window.location.pathname;
            if(langArray.includes(window.location.pathname.substring(1, 3).toUpperCase())){
                //Situation when language is already in the url
                for (let i = 0; i < langArray.length; i++) {
                    if(currentPath.substring(1, 3).toUpperCase() == langArray[i]){
                        let redirectedLang = "";
                        //Selected language is not English 
                        if(li.innerText.slice(1,3).toLowerCase() != "en") redirectedLang = "/" + li.innerText.slice(1,3).toLowerCase();
                        location.href = redirectedLang + currentPath.substring(3);
                    }
                }
            }
            else
            {
                //Situation when English language is the default language
                location.href = "/" + li.innerText.slice(1,3).toLowerCase() + currentPath;
            }

        })
    })

    changeLangBtns[1].nextElementSibling.querySelectorAll('ul li:not(.cursor-no-drop)').forEach(li=>{
        li.addEventListener('click', ()=>{
            localStorage.setItem('lang', li.innerText.slice(1,3).toLowerCase());
            changeLangBtns[0].querySelector('span').textContent = li.innerText.slice(1,3);

            let currentPath = window.location.pathname;
            if(langArray.includes(window.location.pathname.substring(1, 3).toUpperCase())){
                //Situation when language is already in the url
                for (let i = 0; i < langArray.length; i++) {
                    if(currentPath.substring(1, 3).toUpperCase() == langArray[i]){
                        let redirectedLang = "";
                        //Selected language is not English 
                        if(li.innerText.slice(1,3).toLowerCase() != "en") redirectedLang = "/" + li.innerText.slice(1,3).toLowerCase();
                        location.href = redirectedLang + currentPath.substring(3);
                    }
                }
            }
            else
            {
                //Situation when English language is the default language
                location.href = "/" + li.innerText.slice(1,3).toLowerCase() + currentPath;
            }

        })
    })
    //#endregion

</script>
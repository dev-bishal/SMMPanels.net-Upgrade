---
import { metaDataEs, metaDataPt } from '../data/translations';


interface Props {
    searchPagePath: string,
    isDark ?: boolean
    lang ?: string,
}

const {searchPagePath, lang="en", isDark=false} = Astro.props;

let contentPath : {
    language: string;
    text: string[];
} = {
    language : "",
    text : []
};

if(lang == "es")
    contentPath = metaDataEs;
else if((lang == "pt"))
    contentPath = metaDataPt;

---

<div class="searchBox w-full my-5">
    <form onsubmit="return validateSearchForm()"
        action={searchPagePath}
        name="searchPanel"
        class="relative flex gap-3 items-center"
    >
        <input
            required
            type="text"
            name="q"
            id="searchQuery"
            class="w-full p-3 pl-6 hover:p-4 transition-all ease-in-out duration-200 outline-none text-white rounded-full backdrop-blur-sm shadow-xl placeholder:text-gray-300"
            placeholder={
                lang == "en" 
                ? "Search Youtube Services"
                : contentPath?.text[5]
            } class:list={[
                isDark ? "bg-[#50535698]" : "bg-[#cbd5e198]"
            ]}
        />
        <button type="submit" class="absolute right-2 hover:bg-blue-700 bg-blue-500 rounded-full size-10">
            <i class="fa-solid fa-magnifying-glass text-white"></i>
        </button>
    </form>
</div>
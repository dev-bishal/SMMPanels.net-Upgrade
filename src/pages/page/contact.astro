---
import ButtonUI from "../../components/ButtonUI.astro";
import GlassLayout from "../../components/GlassLayout.astro";
import { getAPIPath, JsonToHtml } from "../../data/utils";
import MainLayoutNew from "../../layouts/MainLayoutNew.astro";

//Pages API for Contact Page Content Only
const allPagesFetch: any = await fetch(getAPIPath() + "pages").then(
    (Response) => Response.json(),
);
var contactPageContent;

for (let i = 0; i < allPagesFetch.length; i++) {
    if (allPagesFetch[i].pageTitle.toLowerCase().includes("contact")) {
        contactPageContent = allPagesFetch[i];
        break;
    }
}

const allSettings = await fetch(getAPIPath() + "siteSettings/" + import.meta.env.SITESETTINGSKEY, {
    method: "GET",
    headers: {
        'Content-Type': 'application/json',
        "origin" : "http://localhost:4321",
        // "x-api-key" : key
    },
}).then(Response => Response.json());

---

<MainLayoutNew title="Contact Us" metaDescription="">
    <div class="content-wrapper text-white flex flex-wrap lg:justify-start justify-center gap-5 my-6 px-5 lg:mt-24 mt-20">
        <article class="leading-8">
            <div class="content" set:html={JsonToHtml({ time : 1610972762955, blocks: contactPageContent.pageContent})} />

            <div class="responseMessage hidden w-full justify-center items-center flex-col gap-3" >
                <p class="font-bold text-center text-3xl my-4"></p>
                <a href="/" class="rounded px-4 py-2 bg-[#0056b3] text-white"><i class="fa-solid fa-house"></i> Home</a>
            </div>

            <GlassLayout>
                <form
                    id="contactFrm"
                    method="post"
                    class="flex flex-col justify-center items-center mt-3 w-full" >
                    <div class="fields-container z-[1] w-full flex flex-col gap-3 p-4 rounded" >
                            <h2 class="text-xl font-bold text-left w-full mb-4">
                                Write your message -
                            </h2>
                            <input
                                required
                                class="bg-white border-gray-500 border shadow-md shadow-slate-800 text-slate-800 px-3 py-2 rounded-md"
                                type="text"
                                name="contact_name"
                                id="contact_name"
                                placeholder="Your Name"
                            />
                            <input
                                required
                                class="bg-white border-gray-500 border shadow-md shadow-slate-800 text-slate-800 px-3 py-2 rounded-md"
                                type="email"
                                name="contact_email"
                                id="contact_email"
                                placeholder="Email Address"
                            />
                            <textarea
                                required
                                class="bg-white border-gray-500 border shadow-md shadow-slate-800 text-slate-800 px-3 py-2 rounded-md min-h-32"
                                name="contact_msg"
                                id="contact_msg"
                                placeholder="Your Message"></textarea>
        
                            <!-- Captcha -->
                            <div class="my-3 g-recaptcha" data-sitekey={import.meta.env.CapchaSiteKey}>
        
                            </div>
                            <span class="grid place-items-center">
                                <ButtonUI
                                    id="sendMsgBtn"
                                    title="Send Message"
                                    onclickFunction="submit"
                                    iconClass="fa-solid fa-paper-plane-top"
                                />
                            </span>
                        </div>
                </form>
            </GlassLayout>
        </article>
    </div>
</MainLayoutNew>

<script is:inline src="https://www.google.com/recaptcha/api.js" async defer></script>

<style is:inline>
    article h1 {
        font-size: 22px;
        font-weight: 600;
        padding-bottom: 15px;
        padding-top: 10px;
    }
    .content h1 {
        font-size: 22px;
        font-weight: 600;
        padding-bottom: 15px;
        padding-top: 10px;
    }
    .content h2 {
        font-size: 20px;
        font-weight: 500;
        padding-bottom: 15px;
        padding-top: 10px;
    }
    .content h3 {
        font-size: 19px;
        font-weight: 500;
        padding-bottom: 15px;
        padding-top: 10px;
    }
    .content h4 {
        font-size: 17px;
        font-weight: 500;
        padding-bottom: 15px;
        padding-top: 10px;
    }
    .content h5 {
        font-size: 16px;
        font-weight: 500;
        padding-bottom: 15px;
        padding-top: 10px;
    }
    .content h6 {
        font-size: 15px;
        font-weight: 500;
        padding-bottom: 15px;
        padding-top: 10px;
    }
    .content ol {
        list-style-type: decimal;
        padding-left: 2rem;
    }
    .content p {
        padding-bottom: 15px;
    }

    .content a {
        color: #ff78ec;
    }
    .content a:hover {
        text-decoration-line: underline;
    }
</style>

<script is:inline define:vars={{ API: getAPIPath(),
    emailReplySubject : allSettings.emailAutoReplyContent.emailSubject,
    emailFrom : allSettings.emailAutoReplyContent.emailFrom,
    emailContent : JsonToHtml({ time : 1610972762955, blocks: allSettings.emailAutoReplyContent.emailJs_Content}),
    logoFileName : allSettings.siteLog
 }}>
    const responseSection = document.querySelector(".responseMessage");
    // Function to handle the form submission
    async function handleFormSubmit(event) {
        document.getElementById("sendMsgBtn").disabled = true;
        event.preventDefault(); 

        const form = event.target;
        const formData = new FormData(form);    

        // 2. Prepare the data object
        const data = {
            contact_name: formData.get('contact_name'),
            contact_email: formData.get('contact_email'),
            contact_msg: formData.get('contact_msg'),
            captchaToken: formData.get('g-recaptcha-response'), 
            emailReplySubject,
            emailFrom,
            emailContent,
            logoFileName
        };  

        try {
            const response = await fetch(API + 'messages', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(data),
            }); 

            if (response.ok) {
                alert('Message sent successfully!');
                responseSection.classList.add("flex");
                responseSection.classList.remove("hidden");
                responseSection.querySelector("p").textContent = "Thank You for contacting us. We will reach out to soon!!"
                form.reset();
                form.remove();
            } else {
                responseSection.classList.add("flex");
                responseSection.classList.remove("hidden");
                responseSection.querySelector("p").textContent = "A Problem occured. Your Message could not be sent."
                form.remove();
                const error = await response.json();
                alert(`Error: ${error.error}`);
            }
            
        } catch (err) {
            console.error('Submission error:', err);
            alert('Failed to connect to the server.');
        }
    }

    // Attach listener to the form
    document.querySelector('#contactFrm').addEventListener('submit', handleFormSubmit);

</script>

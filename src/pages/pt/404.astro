---
import MainLayoutNew from "../../layouts/MainLayoutNew.astro";
import { metaDataPt } from "./data";

---

<MainLayoutNew lang={metaDataPt.language} title="Page Not Found" metaDescription=`Page Not Found`>
    <div class="content-wrapper text-white flex flex-wrap lg:justify-start justify-center gap-5 my-6 px-5 lg:mt-24 mt-20">
        <div class="404Content py-8 gap-y-7 size-full flex flex-col justify-center items-center">
            <h1 class="text-2xl">¡¡VAYA!! ERROR 404 </h1>
            <span class="text-4xl">PÁGINA NO ENCONTRADA</span>
            <p>Es posible que se haya eliminado, se le haya cambiado el nombre o no esté disponible temporalmente. ¡Vamos a casa!</p>

            <a href="/" class="rounded px-4 py-2 bg-[#0056b3] text-white"><i class="fa-solid fa-house"></i> Inicio</a>

        </div>
    </div>
</MainLayoutNew>
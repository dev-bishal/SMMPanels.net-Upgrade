---
import MainLayoutNew from "../../../layouts/MainLayoutNew.astro";
import SMM_panelCards2New from "../../../components/SMM_panelCards2New.astro";
import {getAPIPath, getImageBasePath} from "../../../data/utils"
import { metaDataPt } from '../data';
export const prerender = true;

export async function getStaticPaths({ paginate } : {paginate : any}) {
    const responsePanels = await fetch(getAPIPath() + "panels").then(Response => Response.json());

    return paginate(responsePanels.reverse(), { pageSize: 15 });
}

interface panelStructure {
	panelFeaturedImage: {
		url: string;
	};
	id: string;
	panelAPIKey: string;
	panelAPILink: string;
	panelSlug: string;
	panelTextDescription: string;
	panelTitle: string;
	panelTotalServices: number;
	rating: number;
	panelWebsiteURL: string;
}

interface Props {
    page: {
        data: panelStructure[];
        start: number;
        end: number;
        size: number;
        total: number;
        currentPage: number;
        lastPage: number;
        url: {
            current: string;
            next: string;
            prev: string;
            first: string;
            last: string;
        };
    };
}

const { page } = Astro.props;

let allPanelAPIs : string[] = [];
let allPanelServiceCount : any[][] = [];
//Capturing Panel's APIUrl and APIKey
page.data.map((panel:panelStructure) => (
    allPanelAPIs.push(`${panel.panelAPILink}?key=${panel.panelAPIKey}&action=services`)
))

//Executing Every Panel's API to get services
let panelServicesdata=[];
for (let i = 0; i < allPanelAPIs.length; i++) {
    var totalPrice = 0;
    try {
        panelServicesdata = await fetch(allPanelAPIs[i]).then(Response => Response.json());
    } catch (error) {
        console.log(allPanelAPIs[i] + "- Could not Find Services with GET Method");
        panelServicesdata = [];
    }

    try {
        //Fallback to fetch with GET Request
        if(panelServicesdata.length==0){
            panelServicesdata = await fetch(allPanelAPIs[i], {method:'POST'}).then(Response => Response.json());
        }
    } catch (error) {
        console.log(allPanelAPIs[i] + "- Could not Find Services with POST Method");
        panelServicesdata = [];
    }

    if((typeof panelServicesdata === 'string') == false){
        for (let j = 0; j < panelServicesdata.length; j++) {
            if((Number(panelServicesdata[j].rate) < 850) && (Number(panelServicesdata[j].rate) > 0.0001))
                totalPrice += Number(panelServicesdata[j].rate);
        }
        allPanelServiceCount.push([panelServicesdata.length , totalPrice/panelServicesdata.length]);
    }
    else
        allPanelServiceCount.push([NaN , NaN]);
}

const {data, ...rest} = page;
let contentPath = metaDataPt

---

<MainLayoutNew lang={metaDataPt.language} havePadding={false} title={"All SMM Panel Listed on SMM Panel"} metaDescription="">

    <section class="panels-container">
        <div class="relative touch-none pointer-events-none h-[60vh] bg-[url('/assets/images/cover.png')] bg-cover bg-no-repeat">
            <div class="brightnessLow-overlay absolute z-0 bg-gradient-to-b from-[#0000008a] to-[black] w-full h-full"></div>

            <div class="header absolute bottom-4 p-4 flex gap-3 items-end text-white">
                <span>
                    <h1 class="text-xl font-bold mb-3">{contentPath.text[18]}</h1>
                    <p class="font-semi/bold mb-3 leading-6">{contentPath.text[19]}</p>
                </span>
        
                <img src="/assets/images/icons.png" alt="icons image" class="size-36">
            </div>
        </div>
        
        <div class="content-wrapper relative flex flex-wrap lg:justify-start justify-center gap-5 p-5 pt-16">
            <div class="brightnessLow-gradient absolute z-0 bg-gradient-to-b from-[black] to-transparent backdrop-blur-sm w-full h-[50px] top-0 left-0"></div>
            
            <div class="panels-container w-full">
                
                <div class="content-wrapper w-full flex flex-wrap lg:flex-col lg:justify-start items-center justify-center gap-5 my-6 px-5 text-white">

                    <div class="flex flex-col gap-5 lg:max-w-[1260px] xl:max-w-[1400px] ">
                        <span class="text-base font-semibold text-white">{contentPath.text[20]} 👇</span>
        
                        <div class="wrapper flex lg:justify-start md:justify-center items-center flex-wrap gap-4 gap-y-6 my-5">
                            {
                                page.data.map((panel: panelStructure, index:number) => (
                                    <SMM_panelCards2New
                                        lang={metaDataPt.language}
                                        rating = {panel.rating}
                                        avrg = {Number(allPanelServiceCount[index][1].toFixed(2))}
                                        service={Number(allPanelServiceCount[index][0])}
                                        imageSrc = {panel.panelFeaturedImage == null ? "" : getImageBasePath() + panel.panelFeaturedImage }
                                        panelTitle={panel.panelTitle}
                                        slugURL={panel.panelSlug}
                                    />
                                ))
                            }
                            <!-- allPanelServiceCount[0][responsePanels.length - (index + 1)] -->
                        </div>
        
                        <div class="paginationHolder flex flex-col gap-3 w-full items-center my-5 z-[1] text-white"
                            data-pageSize={page.lastPage} >
                            <div class="paginationBtns flex gap-3 items-center">
                                <a href={rest.url.prev} class="prevbtns flex justify-center items-center cursor-pointer rounded-full size-12 bg-[#0056b3] border" 
                                class:list={[
                                    rest.url.prev ? "bg-[#0056b3] cursor-pointer" : "bg-gray-300 cursor-not-allowed"
                                ]}>
                                    <i class="fa-duotone fa-chevrons-left" />
                                </a>
                                <div class="paginationInfo text-center">
                                    <span class="rounded-lg p-4 h-full font-bold ">
                                        {contentPath.text[24]}
                                    </span>
                                    <span class="pageNumber block" >{`${page.currentPage} of ${page.lastPage}`}</span>
                                </div>
                                <a href={page.url.next} class="nextbtns flex justify-center items-center cursor-pointer rounded-full size-12 bg-[#0056b3] border"class:list={[
                                    rest.url.next ? "bg-[#0056b3] cursor-pointer" : "bg-gray-300 cursor-not-allowed"
                                    ]}>
                                    <i class="fa-duotone fa-chevrons-right" />
                                </a>
                            </div>
                        </div>

                    </div>

                </div>

            </div>
        </div>
    </section>

</MainLayoutNew>
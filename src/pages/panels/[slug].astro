<script is:inline define:vars={{ApiInfo : APIError}}>
    if(ApiInfo)
        console.log("API Error- ", ApiInfo);
</script>

<script is:inline>
    var socialModalCloseBtn = document.querySelector(".closeBtn");
    var socialModalContainer = document.querySelector(".modal-container");
    
    socialModalCloseBtn.addEventListener("click", ()=>{
        toggleSocialModal();
    })

    function toggleSocialModal() {
        socialModalContainer.classList.toggle("invisible");
    }


</script>
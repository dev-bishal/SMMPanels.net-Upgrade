---
import MainLayoutNew from "../../../layouts/MainLayoutNew.astro";
import SMM_ServicesCardsNew from "../../../components/SMM_servicesCardsNew.astro"
import SearchFormNew from "../../../components/SearchFormNew.astro";
import { getAPIPath, getImageBasePath, optimizeImageUrl } from "../../../data/utils";
import { metaDataEs, metaDataPt } from "../../../data/translations";

const allSiteFetch:any = await fetch(getAPIPath() + "siteSettings/" + import.meta.env.SITESETTINGSKEY).then(Response => Response.json());

interface serviceSchema{
    serviceColor: string,
    serviceLogo: {
        name: string,
        mediaType: string,
        url: string,
    },
    serviceTitle: string,
    serviceCount: number,
}

//Fetching All Services
const allServicesFetch:any = await fetch(getAPIPath() + "services");
const allServiceRes : serviceSchema[] = await allServicesFetch.json();

const SUPPORTED_LOCALES = ["es", "pt"];
const { lang } = Astro.params;

if (!lang || !SUPPORTED_LOCALES.includes(lang)) {
  return Astro.redirect('/404');
}

let contentPath : {
    language: string;
    text: string[];
} = {
    language : "",
    text : []
};

if(lang == "es")
    contentPath = metaDataEs;
else if((lang == "pt"))
    contentPath = metaDataPt;

let pageTitle="";
lang == "es" ? pageTitle = "Lista de todos los servicios" : "";
lang == "pt" ? pageTitle = "Lista de todos os serviços" : "";

let pageMetaDescription="";
lang == "es" ? pageMetaDescription = "Explora todas las plataformas y servicios de redes sociales que soportan los paneles SMM. Desde seguidores en Instagram hasta vistas en YouTube, descubre soluciones personalizadas para hacer crecer tu presencia en línea" : "";
lang == "pt" ? pageMetaDescription = "Explora todas as plataformas e serviços de redes sociais suportados pelos Painéis de SMM. Desde seguidores no Instagram até visualizações no YouTube, descobre soluções personalizadas para aumentar a tua presença online" : "";
---

<MainLayoutNew 
    lang={lang} 
    havePadding={false}
    title={pageTitle} 
    metaDescription={pageMetaDescription}>

    <section class="services-container text-white pt-24">
        
        <h1 class="font-bold text-center text-2xl">{contentPath.text[28]}</h1>
        <p class="text-center text-xl">{allSiteFetch.servicePageData.servicePagePanelSubTextEs}</p>
        <div class="platform-list-wrapper my-6">
            <div class="services-details w-full flex items-center justify-between flex-col lg:flex-row gap-3 bg-[#000000b9] p-7 uppercase">
                <span class="lg:w-1/2 font-semibold">{contentPath.text[29]}- 
                    <span class="count">{allServiceRes.length}</span>
                </span>
                
                <div class="searchBox flex justify-center items-center lg:w-1/2 w-full">
                    <div class="wrapper w-full">
                        <SearchFormNew {lang} searchPagePath={"/es/services/search"} isDark={true}/>
                    </div>
                </div>
            </div>
            <div class="content-wrapper w-full bg-[#00000089] flex flex-wrap justify-center">
        
                {
                    allServiceRes.map((service, index)=>(
                        <SMM_ServicesCardsNew 
                            {lang}
                            translation={contentPath}
                            servicesCount={service.serviceCount} 
                            title={service.serviceTitle} 
                            imageLogoPath={getImageBasePath() + service.serviceLogo}>
                        </SMM_ServicesCardsNew>
                    ))
                }
    
            </div>
        </div>
        
    </section>
</MainLayoutNew>

<script is:inline src="/assets/scripts/main.js"></script>

<script is:inline>
    allowServiceCardClick(".content-wrapper")
</script>
---
import SearchFormNew from "../../../components/SearchFormNew.astro";
import { metaDataEs, metaDataPt } from "../../../data/translations";
import { getAPIPath, getImageBasePath } from "../../../data/utils";
import MainLayoutNew from "../../../layouts/MainLayoutNew.astro";

const allSiteFetch: any = await fetch(getAPIPath() + "siteSettings/" + import.meta.env.SITESETTINGSKEY).then(
(Response) => Response.json(),
);

const allPanelsFetch: any = await fetch(getAPIPath() + "panels").then(
    (Response) => Response.json(),
);


export function getStaticPaths() {
    let path :any[] = ["es", "pt"];
    
    return path.map((lang : any) => {
        return {
            params: {
                lang: lang
            }
        };
    });
}

const { lang } = Astro.params;

let contentPath : {
    language: string;
    text: string[];
} = {
    language : "",
    text : []
};

if(lang == "es")
    contentPath = metaDataEs;
else if((lang == "pt"))
    contentPath = metaDataPt;


let pageTitle="";
lang == "es" ? pageTitle = `Search Services on ${allSiteFetch.siteData.SiteTitle}` : "";
lang == "pt" ? pageTitle = `Search Services on ${allSiteFetch.siteData.SiteTitle}` : "";

let pageMetaDescription="";
lang == "es" ? pageMetaDescription = `Search among Best SMM Panels, and SMM Services on ${allSiteFetch.siteData.SiteTitle}` : "";
lang == "pt" ? pageMetaDescription = `Search among Best SMM Panels, and SMM Services on ${allSiteFetch.siteData.SiteTitle}` : "";
---

<style is:inline>
    /* Glassmorphism Core */
    .glass-card {
        background: rgba(255, 255, 255, 0.12);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border-radius: 2rem;
        border: 1px solid rgba(255, 255, 255, 0.3);
        box-shadow: 0 8px 32px 0 rgba(31, 38, 135, 0.25);
    }
    
    .glass-input {
        background: rgba(255, 255, 255, 0.2);
        backdrop-filter: blur(6px);
        border: 1px solid rgba(255,255,255,0.35);
        transition: all 0.2s ease;
    }
    
    .glass-input:focus {
        background: rgba(255, 255, 255, 0.3);
        border-color: rgba(255,255,255,0.7);
        outline: none;
        box-shadow: 0 0 0 3px rgba(255,255,255,0.2);
    }
    
    .glass-button {
        background: rgba(255, 255, 255, 0.2);
        backdrop-filter: blur(4px);
        border: 1px solid rgba(255,255,255,0.4);
        transition: all 0.2s ease;
        cursor: pointer;
    }
    
    .glass-button:hover:not(:disabled) {
        background: rgba(255, 255, 255, 0.35);
        transform: scale(0.97);
    }
    
    .glass-button:disabled {
        opacity: 0.4;
        cursor: not-allowed;
    }
    
    .active-page {
        background: rgba(255, 255, 255, 0.45);
        border-color: white;
        font-weight: 600;
        backdrop-filter: blur(8px);
    }
    
    /* Rating Stars */
    .star-filled { color: #FFD966; }
    .star-half { color: #FFD966; }
    .star-empty { color: rgba(255,255,240,0.3); }
    
    /* Table horizontal scroll for mobile */
    .table-wrapper {
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
        scrollbar-width: thin;
        border-radius: 1.2rem;
    }
    
    .custom-scroll::-webkit-scrollbar {
        height: 6px;
        width: 6px;
    }
    
    .custom-scroll::-webkit-scrollbar-track {
        background: rgba(255,255,255,0.2);
        border-radius: 10px;
    }
    
    .custom-scroll::-webkit-scrollbar-thumb {
        background: rgba(255,255,255,0.5);
        border-radius: 10px;
    }
    
    body {
        background: radial-gradient(circle at 20% 30%, rgba(15, 25, 45, 0.92), rgba(5, 10, 22, 0.96)), url('https://images.unsplash.com/photo-1534796636912-3b95b3ab5986?q=80&w=2071&auto=format');
        background-size: cover;
        background-attachment: fixed;
    }
    
    .service-table {
        min-width: 900px;
    }
    
    .service-table th, .service-table td {
        padding: 1rem 1.2rem;
        text-align: left;
        border-bottom: 1px solid rgba(255,255,255,0.12);
        vertical-align: middle;
    }
    
    .service-table th {
        font-weight: 600;
        background: rgba(255,255,255,0.05);
        cursor: pointer;
        user-select: none;
        transition: 0.2s;
    }
    
    .service-table th:hover {
        background: rgba(255,255,255,0.12);
    }
    
    @media (max-width: 640px) {
        .service-table th, .service-table td {
            padding: 0.8rem 1rem;
            font-size: 0.8rem;
            white-space: nowrap;
        }
        .glass-card { border-radius: 1.5rem; padding: 1rem; }
    }
    
    .loading-spinner {
        display: inline-block;
        width: 28px;
        height: 28px;
        border: 3px solid rgba(255,255,255,0.3);
        border-radius: 50%;
        border-top-color: white;
        animation: spin 0.8s linear infinite;
    }
    
    @keyframes spin { to { transform: rotate(360deg); } }
    
    .panel-image {
        width: 40px;
        height: 40px;
        object-fit: cover;
        border-radius: 8px;
        background: rgba(255,255,255,0.1);
    }
    
    .badge-cancel {
        background: rgba(220, 38, 38, 0.3);
        color: #ff9999;
        padding: 2px 8px;
        border-radius: 20px;
        font-size: 11px;
        font-weight: 500;
    }
    
    .badge-dripfeed {
        background: rgba(34, 197, 94, 0.3);
        color: #86efac;
        padding: 2px 8px;
        border-radius: 20px;
        font-size: 11px;
    }
</style>

<MainLayoutNew {lang} title={pageTitle} metaDescription={pageMetaDescription}>

    <div class="content-wrapper text-white flex flex-wrap lg:justify-start justify-center gap-5 my-6 px-5 lg:mt-24 mt-20">
        <article class="flex flex-col gap-5 w-full">

            <div class="text-center p-5 lg:w-full w-[89vw] overflow-auto z-[1]">
                <h1 class="searchResTitle text-2xl font-semibold"></h1>
            </div>
            <div class="searchBox flex justify-center items-center">
                <div class="wrapper lg:w-1/2 w-full">
                    <SearchFormNew {lang} searchPagePath={`/${lang}/services/search`} />
                </div>
            </div>  

            <div class="w-full max-w-[1400px] mx-auto">
    <div class="glass-card p-4 md:p-6 shadow-2xl transition-all">
        <!-- Header -->
        <div class="flex flex-wrap justify-between items-start gap-2 mb-4">
            <div>
                <h1 class="text-2xl md:text-4xl font-bold text-white tracking-tight drop-shadow-md flex items-center gap-3">
                    <i class="fas fa-layer-group text-white/80"></i> 
                    <span id="searchTerm"> Services</span>
                </h1>
                <p class="hidden text-white/70 text-sm mt-1">Real-time API with sorting, rating filter & pagination</p>
            </div>
        </div>

        <!-- Filter & Search Controls -->
        <div class="flex flex-col md:flex-row gap-4 mb-6">
            <!-- Search Input (q parameter) -->
            <div class="relative flex-1 hidden">
                <i class="fas fa-search absolute left-4 top-1/2 -translate-y-1/2 text-white/60 text-sm"></i>
                <input type="text" id="searchInput" placeholder="Search services (Instagram, Twitter, etc.)..." 
                       class="w-full pl-10 pr-4 py-3 rounded-xl glass-input text-white placeholder-white/50 focus:ring-0">
            </div>
            
            <!-- Items per page dropdown - add this after the sorting dropdown -->
            <div class="relative w-full md:w-36">
                <select id="limitSelect" class="w-full appearance-none py-3 px-4 pr-10 rounded-xl glass-input text-white bg-white/20 backdrop-blur cursor-pointer">
                    <option class="text-black" value="10" selected>10 per page</option>
                    <option class="text-black" value="25">25 per page</option>
                    <option class="text-black" value="50">50 per page</option>
                </select>
                <i class="fas fa-table-list absolute right-4 top-1/2 -translate-y-1/2 text-white/60 pointer-events-none"></i>
            </div>

            <!-- Rating Filter Dropdown -->
            <div class="relative w-full md:w-56">
                <select id="ratingFilter" class="w-full appearance-none py-3 px-4 pr-10 rounded-xl glass-input text-white bg-white/20 backdrop-blur cursor-pointer">
                    <option class="text-black" value="">All Ratings</option>
                    <option class="text-black" value="1">1★ & above</option>
                    <option class="text-black" value="2">2★ & above</option>
                    <option class="text-black" value="3">3★ & above</option>
                    <option class="text-black" value="4">4★ & above</option>
                    <option class="text-black" value="5">5★ only</option>
                </select>
                <i class="fas fa-star absolute right-4 top-1/2 -translate-y-1/2 text-white/60 pointer-events-none"></i>
            </div>
            
            <!-- Sorting Dropdown -->
            <div class="relative w-full md:w-64">
                <select id="sortBy" class="w-full appearance-none py-3 px-4 pr-10 rounded-xl glass-input text-white bg-white/20 backdrop-blur cursor-pointer">
                    <option class="text-black" value="min">Price: Low to High (min)</option>
                    <option class="text-black" value="max">Price: High to Low (max)</option>
                    <option class="text-black" value="rate">Rate: Low to High</option>
                    <option class="text-black" value="-rate">Rate: High to Low</option>
                    <option class="text-black" value="panelRating">Rating: Low to High</option>
                    <option class="text-black" value="-panelRating">Rating: High to Low</option>
                    <option class="text-black" value="updated">Latest Updated</option>
                </select>
                <i class="fas fa-arrow-down-wide-short absolute right-4 top-1/2 -translate-y-1/2 text-white/60 pointer-events-none"></i>
            </div>
            
            <button id="resetBtn" class="glass-button text-white px-5 py-3 rounded-xl flex items-center justify-center gap-2 transition">
                <i class="fas fa-undo-alt"></i> Reset
            </button>
        </div>

        <!-- Services Table (Horizontal Scroll on Mobile) -->
        <div class="table-wrapper rounded-2xl overflow-hidden custom-scroll">
            <table class="service-table w-full text-white/90 border-collapse">
                <thead>
                    <tr class="border-b border-white/20">
                        <th data-sort="name">Service Name <i class="fas fa-sort ml-1 opacity-60 text-xs"></i></th>
                        <th data-sort="min">Min <i class="fas fa-sort ml-1 opacity-60 text-xs"></i></th>
                        <th data-sort="max">Max <i class="fas fa-sort ml-1 opacity-60 text-xs"></i></th>
                        <th data-sort="rate">Rate ($) <i class="fas fa-sort ml-1 opacity-60 text-xs"></i></th>
                        <th data-sort="panelRating">Rating <i class="fas fa-sort ml-1 opacity-60 text-xs"></i></th>
                        <th class="hidden">Avg Time (min)</th>
                        <th>Features</th>
                        <th>Category</th>
                        <th>Providing Panel</th>
                    </tr>
                </thead>
                <tbody id="tableBody">
                    <tr><td colspan="9" class="text-center py-12"><div class="loading-spinner mx-auto"></div><div class="mt-3 text-white/70">Fetching services from API...</div></td></tr>
                </tbody>
            </table>
        </div>

        <!-- Pagination & Meta Info -->
        <div class="flex flex-col sm:flex-row justify-between items-center gap-4 mt-6 text-white/80">
            <div class="text-sm bg-white/10 px-4 py-1.5 rounded-full backdrop-blur-sm" id="paginationInfo">
                Loading...
            </div>
            <div class="flex gap-2 flex-wrap justify-center" id="paginationControls"></div>
        </div>
        
        <!-- API Info Note -->
        <div class="mt-4 text-xs text-white/40 text-center border-t border-white/10 pt-3 hidden">
            <i class="fas fa-database mr-1"></i> Connected to API: <span id="apiEndpointDisplay" class="font-mono">/api/smmpanels.net/service_api</span>
        </div>
    </div>
</div>

        </article>
    </div>
</MainLayoutNew>
<script is:inline define:vars={{
    lang,
    API_URL: getAPIPath(), IMAGE_PATH : getImageBasePath()}}>
    // ========================
    // CONFIGURATION
    // ========================
    // Replace this with your actual API endpoint when available
    // The demo uses mock data that perfectly matches your API response structure
    const API_BASE_URL = API_URL + "service_api"; // ← CHANGE TO REAL URL
    
    // For demo purposes, we're using mock data that simulates the exact API response structure
    // When real API is available, simply set USE_MOCK = false and ensure CORS is handled
    const USE_MOCK = false; // Set to false when connecting to real API
    
    // State variables
    let currentParams = {
        q: getQueryParam(),
        sortBy: 'min',
        order: 'asc',
        limit: 10,
        page: 1,
        panelRating: ''
    };

    document.querySelector("#searchTerm").textContent = `Results for - '${getQueryParam()}'`;
    
    let currentStats = {
        totalRecords: 0,
        totalPageCount: 0,
        currentPage: 1,
        limit: 10,
        hasNextPage: false,
        sortedBy: ''
    };
    
    let isLoading = false;
    
    // DOM Elements
    const searchInput = document.getElementById('searchInput');
    const ratingFilter = document.getElementById('ratingFilter');
    const sortSelect = document.getElementById('sortBy');
    const resetBtn = document.getElementById('resetBtn');
    const tableBody = document.getElementById('tableBody');
    const paginationInfo = document.getElementById('paginationInfo');
    const paginationControls = document.getElementById('paginationControls');
    const apiEndpointDisplay = document.getElementById('apiEndpointDisplay');
    const limitSelect = document.getElementById('limitSelect');

    function getQueryParam() {
        const urlParams = new URLSearchParams(window.location.search);
        return urlParams.get('q') || '';
    }

    // Helper: Render Stars based on panelRating (1-5)
    function renderStars(rating) {
        const fullStars = Math.floor(rating);
        const hasHalf = rating % 1 >= 0.5;
        const emptyStars = 5 - fullStars - (hasHalf ? 1 : 0);
        let starHtml = '';
        for (let i = 0; i < fullStars; i++) starHtml += '<i class="fas fa-star star-filled text-xs sm:text-sm"></i>';
        if (hasHalf) starHtml += '<i class="fas fa-star-half-alt star-half text-xs sm:text-sm"></i>';
        for (let i = 0; i < emptyStars; i++) starHtml += '<i class="far fa-star star-empty text-xs sm:text-sm"></i>';
        return `<div class="flex items-center gap-1">${starHtml}<span class="ml-1 text-white/70 text-[11px]">(${rating.toFixed(1)})</span></div>`;
    }
    
    // Format numbers with commas
    function formatNumber(num) {
        if (num >= 1000000000) return (num / 1000000000).toFixed(1) + 'B';
        if (num >= 1000000) return (num / 1000000).toFixed(1) + 'M';
        if (num >= 1000) return (num / 1000).toFixed(1) + 'K';
        return num.toString();
    }
    
    // Generate mock data that follows your exact API structure
    function generateMockServices(page, limit, q, sortBy, order, ratingFilter) {
        const baseServices = [
            { _id: "6999f589a84e17a0769bd739", name: "Instagram Views (200k/day) | Own Server", average_time: 20, cancel: true, category: "Instagram views updated", dripfeed: false, max: 2147483647, min: 10, panelImage: "https://picsum.photos/id/1/80/80", panelRating: 3, panelSlug: "pakfollowers.com", panelTitle: "PakFollowers.com", rate: 0.000927, refill: false, updatedAt: "2026-02-21T18:12:23.136Z" },
            { _id: "6999f589a84e17a0769bd740", name: "Instagram Likes (Instant Delivery)", average_time: 5, cancel: false, category: "Instagram likes", dripfeed: false, max: 50000, min: 50, panelImage: "https://picsum.photos/id/20/80/80", panelRating: 4.5, panelSlug: "instagrow.com", panelTitle: "InstaGrow", rate: 0.0025, refill: true, updatedAt: "2026-02-20T10:00:00Z" },
            { _id: "6999f589a84e17a0769bd741", name: "Twitter Retweets (Real Accounts)", average_time: 15, cancel: true, category: "Twitter", dripfeed: true, max: 10000, min: 20, panelImage: "https://picsum.photos/id/26/80/80", panelRating: 4.2, panelSlug: "tweetboost.com", panelTitle: "TweetBoost", rate: 0.018, refill: false, updatedAt: "2026-02-19T15:30:00Z" },
            { _id: "6999f589a84e17a0769bd742", name: "YouTube Subscribers (High Retention)", average_time: 48, cancel: false, category: "YouTube", dripfeed: true, max: 100000, min: 100, panelImage: "https://picsum.photos/id/30/80/80", panelRating: 4.8, panelSlug: "ytboost.com", panelTitle: "YTBoost", rate: 0.085, refill: true, updatedAt: "2026-02-18T20:00:00Z" },
            { _id: "6999f589a84e17a0769bd743", name: "Facebook Page Followers", average_time: 24, cancel: true, category: "Facebook", dripfeed: false, max: 500000, min: 500, panelImage: "https://picsum.photos/id/50/80/80", panelRating: 3.9, panelSlug: "fbpanel.com", panelTitle: "FBPanel", rate: 0.0095, refill: false, updatedAt: "2026-02-17T12:00:00Z" }
        ];
        
        // Generate more mock data to simulate pagination (total 42 items for demo)
        let allServices = [...baseServices];
        for (let i = 1; i <= 37; i++) {
            allServices.push({
                _id: `mock_${i}`,
                name: `${i % 2 === 0 ? "TikTok" : "Telegram"} ${i % 3 === 0 ? "Views" : "Members"} Service #${i}`,
                average_time: 10 + (i % 30),
                cancel: i % 3 === 0,
                category: i % 2 === 0 ? "TikTok" : "Telegram",
                dripfeed: i % 5 === 0,
                max: 100000 * (i % 10 + 1),
                min: 10 * (i % 20 + 1),
                panelImage: `https://picsum.photos/id/${(i % 70) + 10}/80/80`,
                panelRating: 2 + (i % 30) / 10,
                panelSlug: `panel${i}.com`,
                panelTitle: `Panel ${i}`,
                rate: 0.0005 + (i % 100) / 10000,
                refill: i % 4 === 0,
                updatedAt: new Date(Date.now() - i * 86400000).toISOString()
            });
        }
        
        // Apply search filter
        let filtered = allServices.filter(s => s.name.toLowerCase().includes(q.toLowerCase()));
        
        // Apply rating filter
        if (ratingFilter && ratingFilter !== '') {
            const minRating = parseInt(ratingFilter);
            filtered = filtered.filter(s => s.panelRating >= minRating);
        }
        
        // Apply sorting
        const sortField = sortBy;
        const sortOrder = order;
        filtered.sort((a, b) => {
            let aVal, bVal;
            if (sortField === 'min') { aVal = a.min; bVal = b.min; }
            else if (sortField === 'max') { aVal = a.max; bVal = b.max; }
            else if (sortField === 'rate') { aVal = a.rate; bVal = b.rate; }
            else if (sortField === 'panelRating') { aVal = a.panelRating; bVal = b.panelRating; }
            else if (sortField === 'updated') { aVal = new Date(a.updatedAt); bVal = new Date(b.updatedAt); }
            else { aVal = a.name; bVal = b.name; }
            
            if (sortOrder === 'asc') return aVal > bVal ? 1 : -1;
            else return aVal < bVal ? 1 : -1;
        });
        
        // Paginate
        const start = (page - 1) * limit;
        const paginated = filtered.slice(start, start + limit);
        const totalRecords = filtered.length;
        const totalPageCount = Math.ceil(totalRecords / limit);
        
        return {
            services: paginated,
            stats: {
                totalRecords,
                uniquePanelsData: [],
                totalPageCount,
                currentPage: page,
                limit,
                hasNextPage: page < totalPageCount,
                sortedBy: `${sortField} (${sortOrder})`
            }
        };
    }
    
    // Actual API call function (supports both mock and real)
    async function fetchServicesFromAPI() {
        if (isLoading) return;
        
        isLoading = true;
        tableBody.innerHTML = `<tr><td colspan="9" class="text-center py-12"><div class="loading-spinner mx-auto"></div><div class="mt-3 text-white/70">Loading services...</div></td></tr>`;
        
        try {
            let response;
            
            if (USE_MOCK) {
                // Simulate network delay
                await new Promise(resolve => setTimeout(resolve, 500));
                const mockData = generateMockServices(
                    currentParams.page, 
                    currentParams.limit, 
                    currentParams.q, 
                    currentParams.sortBy, 
                    currentParams.order,
                    currentParams.panelRating
                );
                response = { services: mockData.services, stats: mockData.stats };
            } else {
                // REAL API CALL - build URL with parameters
                const url = new URL(API_BASE_URL);
                url.searchParams.append('q', currentParams.q);
                url.searchParams.append('sortBy', currentParams.sortBy);
                url.searchParams.append('order', currentParams.order);
                url.searchParams.append('limit', currentParams.limit);
                url.searchParams.append('page', currentParams.page);
                if (currentParams.panelRating) url.searchParams.append('panelRating', currentParams.panelRating);
                
                const apiResponse = await fetch(url.toString());
                if (!apiResponse.ok) throw new Error(`API Error: ${apiResponse.status}`);
                response = await apiResponse.json();
            }
            
            // Update stats from API response
            currentStats = response.stats;
            renderTableRows(response.services);
            renderPaginationControls();
            
        } catch (error) {
            console.error("API Fetch Error:", error);
            tableBody.innerHTML = `<tr><td colspan="9" class="text-center py-12 text-red-300"><i class="fas fa-exclamation-triangle mr-2"></i>Failed to load data. ${!USE_MOCK ? 'Check API endpoint or CORS.' : 'Mock error.'}</td></tr>`;
        } finally {
            isLoading = false;
        }
    }
    
    function renderTableRows(services) {
        if (!services || services.length === 0) {
            tableBody.innerHTML = `<tr><td colspan="9" class="text-center py-12 text-white/60"><i class="fas fa-inbox mr-2"></i>No services found</td></tr>`;
            return;
        }
        
        tableBody.innerHTML = services.map(service => `
            <tr class="border-b border-white/10 hover:bg-white/5 transition">
                <td class="font-medium max-w-[250px] truncate" title="${escapeHtml(service.name)}">${escapeHtml(service.name)}</td>
                <td class="font-mono text-sm">${formatNumber(service.min)}</td>
                <td class="font-mono text-sm">${formatNumber(service.max)}</td>
                <td class="font-mono font-semibold">$${service.rate.toFixed(6)}</td>
                <td>${renderStars(service.panelRating)}</td>
                <td class="text-sm hidden">${service.average_time} min</td>
                <td>
                    ${service.cancel ? '<span class="badge-cancel inline-block mr-1"><i class="fas fa-ban mr-1"></i>Cancel</span>' : ''}
                    ${service.dripfeed ? '<span class="badge-dripfeed inline-block"><i class="fas fa-tint mr-1"></i>Dripfeed</span>' : ''}
                    ${service.refill ? '<span class="bg-blue-500/30 text-blue-200 px-2 py-0.5 rounded-full text-xs ml-1">Refill</span>' : ''}
                </td>
                <td class="text-sm max-w-[120px] truncate">${escapeHtml(service.category)}</td>
                <td>
                    <div class="flex items-center gap-2">
                        <img src="${IMAGE_PATH + service.panelImage}" alt="panel" class="panel-image w-[80px] h-[50px] rounded" >
                        <div class="flex flex-col">
                            <a href="/${lang}/panels/${service.panelSlug}" target="_blank" rel="noopener noreferrer" class="text-white/90 hover:text-white underline text-sm font-medium">${escapeHtml(service.panelTitle)}</a>
                            <span class="text-[10px] text-white/50">${escapeHtml(service.panelSlug)}</span>
                        </div>
                    </div>
                </td>
            </tr>
        `).join('');
    }
    
    function renderPaginationControls() {
        const { totalPageCount, currentPage, totalRecords, limit } = currentStats;
        const startItem = totalRecords === 0 ? 0 : (currentPage - 1) * limit + 1;
        const endItem = Math.min(currentPage * limit, totalRecords);
        paginationInfo.innerText = `Showing ${startItem}–${endItem} of ${totalRecords} services | Page ${currentPage} of ${totalPageCount}`;
        
        if (totalPageCount <= 1) {
            paginationControls.innerHTML = `<span class="text-white/40 text-sm">—</span>`;
            return;
        }
        
        let html = '';
        html += `<button class="glass-button rounded-full px-4 py-1.5 text-sm transition" data-page="prev" ${currentPage === 1 ? 'disabled' : ''}><i class="fas fa-chevron-left"></i></button>`;
        
        let startPage = Math.max(1, currentPage - 2);
        let endPage = Math.min(totalPageCount, currentPage + 2);
        
        if (startPage > 1) {
            html += `<button class="glass-button rounded-full w-9 h-9 text-sm" data-page="1">1</button>`;
            if (startPage > 2) html += `<span class="px-1 text-white/50">...</span>`;
        }
        
        for (let i = startPage; i <= endPage; i++) {
            const active = i === currentPage ? 'active-page border-white/70 font-bold' : '';
            html += `<button class="glass-button rounded-full w-9 h-9 text-sm ${active}" data-page="${i}">${i}</button>`;
        }
        
        if (endPage < totalPageCount) {
            if (endPage < totalPageCount - 1) html += `<span class="px-1 text-white/50">...</span>`;
            html += `<button class="glass-button rounded-full w-9 h-9 text-sm" data-page="${totalPageCount}">${totalPageCount}</button>`;
        }
        
        html += `<button class="glass-button rounded-full px-4 py-1.5 text-sm transition" data-page="next" ${currentPage === totalPageCount ? 'disabled' : ''}><i class="fas fa-chevron-right"></i></button>`;
        
        paginationControls.innerHTML = html;
        
        // Attach event listeners
        document.querySelectorAll('#paginationControls button[data-page]').forEach(btn => {
            btn.addEventListener('click', (e) => {
                if (isLoading) return;
                const pageVal = btn.getAttribute('data-page');
                let newPage = currentPage;
                if (pageVal === 'prev') newPage = Math.max(1, currentPage - 1);
                else if (pageVal === 'next') newPage = Math.min(totalPageCount, currentPage + 1);
                else newPage = parseInt(pageVal, 10);
                
                if (newPage !== currentParams.page) {
                    currentParams.page = newPage;
                    fetchServicesFromAPI();
                }
            });
        });
    }
    
    // Handle filter/sort changes
    let debounceTimer;
    function applyFiltersAndReload() {
        if (debounceTimer) clearTimeout(debounceTimer);
        debounceTimer = setTimeout(() => {
            // Update currentParams from UI
            currentParams.q = searchInput.value.trim() || getQueryParam();
            currentParams.panelRating = ratingFilter.value;
            
            const sortValue = sortSelect.value;
            if (sortValue === 'min') { currentParams.sortBy = 'min'; currentParams.order = 'asc'; }
            else if (sortValue === 'max') { currentParams.sortBy = 'max'; currentParams.order = 'asc'; }
            else if (sortValue === 'rate') { currentParams.sortBy = 'rate'; currentParams.order = 'asc'; }
            else if (sortValue === '-rate') { currentParams.sortBy = 'rate'; currentParams.order = 'desc'; }
            else if (sortValue === 'panelRating') { currentParams.sortBy = 'panelRating'; currentParams.order = 'asc'; }
            else if (sortValue === '-panelRating') { currentParams.sortBy = 'panelRating'; currentParams.order = 'desc'; }
            else if (sortValue === 'updated') { currentParams.sortBy = 'updated'; currentParams.order = 'desc'; }
            
            currentParams.page = 1; // Reset to first page on new filters
            fetchServicesFromAPI();
        }, 400);
    }

    function pageLimit(){
        debugger
        currentParams.limit = parseInt(limitSelect.value);
        currentParams.page = 1; // Reset to first page when changing items per page
        fetchServicesFromAPI();
    }
    
    function resetAllFilters() {
        searchInput.value = getQueryParam();
        ratingFilter.value = '';
        sortSelect.value = 'min';
        
        // Add this line to reset limit dropdown
        const limitSelect = document.getElementById('limitSelect');
        if (limitSelect) limitSelect.value = '10';
        
        currentParams = {
            q: getQueryParam(),
            sortBy: 'min',
            order: 'asc',
            limit: 10,  // ← Change to 10
            page: 1,
            rating: ''
        };
        fetchServicesFromAPI();
    }
    
    function escapeHtml(str) {
        if (!str) return '';
        return str.replace(/[&<>]/g, function(m) {
            if (m === '&') return '&amp;';
            if (m === '<') return '&lt;';
            if (m === '>') return '&gt;';
            return m;
        });
    }
    
    // Event Bindings
    function bindEvents() {
        searchInput.addEventListener('input', applyFiltersAndReload);
        ratingFilter.addEventListener('change', applyFiltersAndReload);
        sortSelect.addEventListener('change', applyFiltersAndReload);
        resetBtn.addEventListener('click', resetAllFilters);
        limitSelect.addEventListener('change', pageLimit);

        // Column header sorting
        document.querySelectorAll('[data-sort]').forEach(header => {
            header.addEventListener('click', () => {
                const sortKey = header.getAttribute('data-sort');
                if (sortKey === 'name') { sortSelect.value = 'name'; applyFiltersAndReload(); }
                else if (sortKey === 'min') { sortSelect.value = 'min'; applyFiltersAndReload(); }
                else if (sortKey === 'max') { sortSelect.value = 'max'; applyFiltersAndReload(); }
                else if (sortKey === 'rate') { 
                    sortSelect.value = sortSelect.value === 'rate' ? '-rate' : 'rate'; 
                    applyFiltersAndReload(); 
                }
                else if (sortKey === 'panelRating') {
                    sortSelect.value = sortSelect.value === 'panelRating' ? '-panelRating' : 'panelRating';
                    applyFiltersAndReload();
                }
                else if (limitSelect) {
                    
                }
            });
        });
    }
    
    // Initialize
    function init() {
        bindEvents();
        if (apiEndpointDisplay) apiEndpointDisplay.textContent = USE_MOCK ? "DEMO MODE (Mock Data)" : API_BASE_URL;
        fetchServicesFromAPI();
    }
    
    init();
</script>
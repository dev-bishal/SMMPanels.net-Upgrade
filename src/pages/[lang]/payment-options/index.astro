---
import GlassLayout from "../../../components/GlassLayout.astro";
import PaymentCard from "../../../components/PaymentCard.astro";
import { metaDataEs, metaDataPt } from "../../../data/translations";
import { getAPIPath, getImageBasePath } from "../../../data/utils";
import MainLayoutNew from "../../../layouts/MainLayoutNew.astro";

interface paymentOptionStructure{
    id: string,
    paymentLogo: string,
    paymentOptTitle: string,
}
const allPaymentOptions : paymentOptionStructure[] = await fetch(getAPIPath() + "payments").then(Response => Response.json());

const SUPPORTED_LOCALES = ["es", "pt"];
const { lang } = Astro.params;

if (!lang || !SUPPORTED_LOCALES.includes(lang)) {
  return Astro.redirect('/404');
}

let contentPath : {
    language: string;
    text: string[];
} = {
    language : "",
    text : []
};

if(lang == "es")
    contentPath = metaDataEs;
else if((lang == "pt"))
    contentPath = metaDataPt;

let pageTitle="";
lang == "es" ? pageTitle = "Lista de opciones de pago compatibles con nuestros paneles SMM destacados" : "";
lang == "pt" ? pageTitle = "Lista de opções de pagamento disponíveis nos nossos painéis SMM em destaque" : "";

let pageMetaDescription="";
lang == "es" ? pageMetaDescription = "Descubre la lista completa de métodos de pago que admiten los principales paneles de SMM. Desde PayPal y tarjetas de crédito hasta criptomonedas y pasarelas locales, encuentra opciones seguras y flexibles que se adapten a tus necesidades" : "";
lang == "pt" ? pageMetaDescription = "Descobre a lista completa de métodos de pagamento suportados pelos principais painéis de SMM. Desde PayPal e cartões de crédito a criptomoedas e gateways locais, encontra opções seguras e flexíveis que se adaptam às tuas necessidades" : "";
---

<MainLayoutNew {lang} havePadding={true} 
title={pageTitle}
metaDescription={pageMetaDescription}>
    
    <!-- Hero Section -->
    <GlassLayout otherClass='mt-20 my-6'>
		<div class="wrapper z-[1] lg:w-[1100px] h-full py-10 px-5 lg:px-0 overflow-hidden">
            <div class="hero-content flex flex-col lg:flex-row justify-center items-center h-full w-full">
                <div data-aos="fade-right" data-aos-delay="2500"
                    class="part lg:w-1/2 mt-10 lg:mt-0 h-full flex flex-col justify-center gap-5 text-white">
                    <h2 class="font-semibold text-5xl">{contentPath.text[25]}</h2>
                    <p>{contentPath.text[26]}</p>
                </div>
                <div data-aos="fade-left" data-aos-delay="2500" class="part lg:w-1/2 h-full flex justify-center items-center">
                    <img src="/assets/images/payment-option-hero-img2.png" class="h-full" alt={`Payment Option Header Image`}>
                </div>
            </div>
        </div>
	</GlassLayout>

    <!-- Payment options Sections-->
    <span class="flex w-full lg:justify-between lg:items-center gap-2 mb-3 flex-col lg:flex-row">
        <h2 class="uppercase text-xl text-white font-bold">
            {contentPath.text[27]}-
        </h2>
    </span>
    <section class="payment-options-container relative w-full flex flex-wrap gap-2 items-center" class:list={[
        allPaymentOptions.length > 3 ? "justify-center" : "justify-start"
    ]}>
        {
            allPaymentOptions.map((paymentOption : paymentOptionStructure)=>(
                <PaymentCard {lang} img={getImageBasePath() + paymentOption.paymentLogo} panelsCount={12} title={paymentOption.paymentOptTitle} />
            ))
        }
    </section>

</MainLayoutNew>
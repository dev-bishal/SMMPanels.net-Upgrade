---
import SMMPanelPaymentOptCard from "../../../components/SMM_panel_PaymentOptCard.astro";
import { getAPIPath, getImageBasePath, optimizeImageUrl } from "../../../data/utils";
import MainLayoutNew from "../../../layouts/MainLayoutNew.astro";
import { metaDataEs, metaDataPt } from "../../../data/translations";

interface paymentOptionSchema {
    id: string,
    paymentLogo: string,
    paymentOptTitle: string,
    textContent : any
}

export const prerender = true;
export async function getStaticPaths() {
    const allpaymentOptionRes : paymentOptionSchema[] = await fetch(getAPIPath() + "payments").then(Response => Response.json());
    const languages = ["es", "pt"];

    return languages.flatMap((lang) => {
        return allpaymentOptionRes.map((paymentOption: paymentOptionSchema) => ({
            params: { lang, slug: paymentOption.paymentOptTitle.toLowerCase().replaceAll(" ", "-").replaceAll("/", "-") },
            props: { paymentOption },
        }));
    });
}

const { paymentOption } = Astro.props;
const { slug, lang } = Astro.params;

let contentPath : {
    language: string;
    text: string[];
} = {
    language : "",
    text : []
};

if(lang == "es")
    contentPath = metaDataEs;
else if((lang == "pt"))
    contentPath = metaDataPt;

// After Payment Options are fetched, Fetch the Panels that supports indivisual Payment Option
const allPanelRes = await fetch(getAPIPath() + "panels").then(Response => Response.json());
// const allPanelRes :any[] = await fetch("https://smmpanels.net/panels").then(Response => Response.json());

let supportedPanels = [];

for (let i = 0; i < allPanelRes.length; i++) {
    for (let j = 0; j < allPanelRes[i].paymentOptions.length; j++) {
        if(allPanelRes[i].paymentOptions[j].payOption.toLowerCase().replaceAll(" ", "-").replaceAll("/", "-") === slug)
            supportedPanels.push(allPanelRes[i]);
    }
}

---

<MainLayoutNew 
    {lang}
    title={paymentOption.paymentOptTitle} 
    metaDescription={`List of SMM Panels that supports ${slug[0].toUpperCase()} as Payment Option`} 
    pageType="article"
    pageFeaturedImage={getImageBasePath() + paymentOption.paymentLogo}>

    <div class="content-wrapper w-full flex flex-wrap lg:flex-col lg:justify-start items-center justify-center gap-5 mt-20 my-6 px-5 text-white">

        <article class="flex flex-col gap-5 lg:w-[1260px] xl:w-[1400px]">
            <h1 class="font-bold text-center text-2xl">{contentPath.text[47]} <span class="capitalize">{slug}</span> {contentPath.text[48]}</h1>
            <h2 class="font-semibold text-xl flex gap-2">{contentPath.text[49]} <img src={getImageBasePath() + paymentOption.paymentLogo} height="28px" class="size-7 object-contain min-w-[3rem]" alt={`${slug} Logo`}> {slug}</h2>
            
            <div class="wrapper flex lg:justify-start md:justify-center items-center flex-wrap gap-4 gap-y-6 my-5">
                {
                    supportedPanels.length > 0 &&
                    supportedPanels.map((panel)=>(
    
                        <SMMPanelPaymentOptCard
                            {lang}
                            imageSrc = {getImageBasePath() + panel.panelFeaturedImage}
                            panelTitle = {panel.panelTitle}
                            slugURL = {panel.panelSlug}
                            payMethods = {panel.paymentOptions}
                            requiredPaymentMatch = {slug}
                        />
    
                    ))
                }
            </div>
        </article>

    </div>

</MainLayoutNew>
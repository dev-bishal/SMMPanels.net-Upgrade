---
import Prose from "../../../components/Prose.astro";
import { AIPrompt, getAPIPath, getLanguage, JsonToHtml } from "../../../data/utils";
import MainLayoutNew from "../../../layouts/MainLayoutNew.astro";
import { metaDataEs, metaDataPt } from "../../../data/translations";
export const prerender = true;

interface pageSchema{
    pageTitle  : string,
    pageContent  : string,
    pageTextDescriptionES  : string,
    pageSlug  : string,
}

export async function getStaticPaths (){

    const allPagesFetch:any = await fetch(getAPIPath() + "pages")
    const allPageRes : pageSchema[] = await allPagesFetch.json();
    
    for (let i = 0; i < allPageRes.length; i++) {
        if(allPageRes[i].pageTitle.toLowerCase().includes("contact")){
            allPageRes.splice(i, 1);
        }
    }

    const languages = ["es", "pt"];
    
    // Return a single flat array containing paginated routes for every language
    return languages.flatMap((lang) => {
        return allPageRes.map((page:any) => ({
            params : { lang, slug: page.pageSlug },
            props: { page },
        }))
    });

} ;

const { page } = Astro.props;
const { lang } = Astro.params;

let contentPath : {
    language: string;
    text: string[];
} = {
    language : "",
    text : []
};

if(lang == "es")
    contentPath = metaDataEs;
else if((lang == "pt"))
    contentPath = metaDataPt;

---

<MainLayoutNew 
    {lang} 
    translations={contentPath}
    title={page.pageTitle} 
    metaDescription={lang == "es" ? page.pageMetaDescriptionES : page.pageMetaDescriptionPT}>
    
    <div class="content-wrapper text-white flex flex-wrap lg:justify-start justify-center gap-5 my-6 px-5 lg:mt-24 mt-20">

        <article class="text-white">
            <Prose>
                <h1>{page.pageTitle}</h1>
                <div class="content" set:html={lang == "es" ? page.pageTextDescriptionES : page.pageTextDescriptionPT}></div>
            </Prose>
        </article>

    </div>
</MainLayoutNew>

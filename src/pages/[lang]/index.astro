---
import GlassLayout from "../../components/GlassLayout.astro";
import SearchFormNew from "../../components/SearchFormNew.astro";
import SMM_panelCardsNew from "../../components/SMM_panelCardsNew.astro";
import ServicesSlider from "../../components/ServicesSlider.astro";
import { getAPIPath, getImageBasePath } from "../../data/utils";
import MainLayoutNew from "../../layouts/MainLayoutNew.astro";
import ButtonUI from "../../components/ButtonUI.astro";
import { Image } from "astro:assets";
import { getRelativeLocaleUrl } from "astro:i18n";

import { metaDataEs, metaDataPt } from "../../data/translations";

const SUPPORTED_LOCALES = ["es", "pt"];
const { lang } = Astro.params;

if (!lang || !SUPPORTED_LOCALES.includes(lang)) {
  return Astro.redirect('/404');
}

let contentPath : {
    language: string;
    text: string[];
} = {
    language : "",
    text : []
};

if(lang == "es")
    contentPath = metaDataEs;
else if((lang == "pt"))
    contentPath = metaDataPt;


interface serviceSchema{
    serviceColor: string,
    serviceLogo: string,
    serviceTitle: string,
}

//Fetching Site Settings
const allSiteFetch:any = await fetch(getAPIPath() + "siteSettings/" + import.meta.env.SITESETTINGSKEY).then(Response => Response.json());

//Fetching All Services
const allServicesFetch:any = await fetch(getAPIPath() + "services");
const allServiceRes : serviceSchema[] = await allServicesFetch.json();

interface panelStructure {
	panelFeaturedImage: string;
	id: string;
	panelAPIKey: string;
	panelAPILink: string;
	panelSlug: string;
	panelMetaDescriptionES: string;
	panelMetaDescriptionPT: string;
	panelTitle: string;
	panelTotalServices: number;
	panelWebsiteURL: string;
}

const allPanels = await fetch(getAPIPath() + "panels");
const responsePanels = await allPanels.json();
const panelsList = responsePanels.reverse();
let secondListStartIndex;
if(responsePanels.length <= 3) secondListStartIndex = 0
else secondListStartIndex = 3;

/* const allSidebarWidgetsFetch: any = await fetch(getAPIPath() + "api/sidebarWidgets.json").then(
    (Response) => Response.json(),
); */

const allSidebarWidgetsFetch :any[] = [];

---
<style is:inline>
    .article-Schema:nth-child(1):hover .textContent{
        transform: translate(0, 0);
    }
</style>
<MainLayoutNew title={lang == "es" ? "Inicio" : "Início"} metaDescription={lang == "es" ? allSiteFetch.siteData.SiteMetaDescriptionEs : allSiteFetch.siteData.SiteMetaDescriptionPt} {lang} translations={contentPath}>
	
	<!-- Hero section -->
	<GlassLayout otherClass='mt-20 my-6 px-5'>
		<div class="wrapper z-[1] lg:w-[1100px] h-full py-10 px-5 lg:px-0 overflow-hidden">
            <div class="hero-content flex flex-col lg:flex-row justify-center items-center h-full w-full">
                <div data-aos="fade-right" data-aos-delay="2500"
                    class="part lg:w-1/2 mt-10 lg:mt-0 h-full flex flex-col justify-center gap-5 text-white">
                    <h2 class="font-semibold text-5xl">{allSiteFetch.homePageData.homeHeaderTitleEs}</h2>
                    <p>{allSiteFetch.homePageData.homeHeaderParagraphEs}</p>
                    <div class="CTABtn flex gap-3">
						<SearchFormNew {lang} searchPagePath=`/${lang}/search`/>
                    </div>
                </div>
                <div data-aos="fade-left" data-aos-delay="2500" class="part lg:w-1/2 h-full flex justify-center items-center">
                    <img src={getImageBasePath() + allSiteFetch.homePageData.homeBackgroundImage} class="h-full" alt={`${allSiteFetch.siteData.SiteTitle} Header Image`}>
                </div>
            </div>
        </div>
	</GlassLayout>

    <!-- Services Slider section -->
    {
        allServiceRes.length > 0 &&
        <ServicesSlider {lang} translations={contentPath} allServicesData={allServiceRes} />
    }

    <!-- Panels Sections-->
    <section class="panel-container relative w-full flex flex-col justify-center items-center">
        
        {
            (responsePanels.length == 0) 
            ? <h2 class="text-xl font-semibold text-center text-white">No Panel is listed at the moment.</h2>
            : <div class="wrapper lg:w-[1100px] h-full lg:pt-24 pb-12 flex items-center flex-col gap-5 overflow-hidden px-5 lg:px-0">
                <h3 class="text-yellow-400 font-semibold text-center">{contentPath.text[9]}</h3>
                <p class="text-white font-bold text-3xl lg:w-[60%] text-center">{contentPath.text[10]}</p>
              </div>
        }
        {
            (responsePanels.length > 0 && responsePanels.length > 3) && 
            

            <div class="recent-Panels-container flex flex-col lg:flex-row backdrop-blur-sm gap-4 justify-center  h-full w-full text-white">
    
                <div data-aos="fade-right" class="part lg:w-1/2 h-full flex flex-col justify-center gap-5 leading-6">
                    <article class="article-Schema relative overflow-hidden flex flex-col justify-center rounded-lg transition-all ease-in-out hover:shadow-xl group">
                        <Image src={
                            panelsList[0].panelFeaturedImage
                            ? getImageBasePath() + panelsList[0].panelFeaturedImage
                            : "/assets/images/no-image-available.jpg"
                        } width="815" height="400" alt={panelsList[0].panelTitle} class="rounded-lg hover:brightness-75 w-full" />
                        
                        <div class="textContent absolute translate-y-full bg-[#000000e2] p-6 bottom-0 transition-all ease-in-out duration-500 w-full group-hover:translate-y-0">
                            <a class="contents hover:text-blue-300" href={getRelativeLocaleUrl(lang, "panels/"+ panelsList[0].panelSlug)}><h3 class="w-fit cursor-pointer font-bold text-xl line-clamp-2">{panelsList[0].panelTitle}</h3></a>
                            <span class="description text-xs" set:html={panelsList[0].panelMetaDescriptionES.substring(0, 150) + "..."}></span>
                        </div>
                    </article>
                </div>
    
                <div data-aos="fade-left" class="part lg:w-1/2 h-auto flex flex-col gap-[20px] justify-between items-center">

                    {
                        panelsList.slice(1, 3).map((panel:any, index: number)=>(
                            <article class="article-Schema flex lg:w-auto w-full flex-col lg:flex-row justify-center p-3 rounded-lg bg-[#00000035] gap-3 transition-all ease-in-out hover:scale-105 hover:shadow-xl">
                                <Image src={
                                    panel.panelFeaturedImage
                                    ? getImageBasePath() + panel.panelFeaturedImage
                                    : "/assets/images/no-image-available.jpg"
                                } alt={panel.panelTitle} width="440" height="225" class="rounded-lg lg:w-[15rem] w-full lg:h-[9rem] object-cover hover:brightness-75" />
                        
                                <span class="details">
                                    <a class="contents hover:text-blue-300" href={getRelativeLocaleUrl(lang,"panels/"+ panel.panelSlug)}><h3 class="w-fit cursor-pointer font-bold text-xl line-clamp-2">{panel.panelTitle}</h3></a>
                                    <span class="hidden lg:block description my-3 text-sm line-clamp-3" set:html={panelsList[0].panelMetaDescriptionES.substring(0, 150) + "..."}></span>
                                </span>
                            </article>
                        ))
                    }

                </div>
            </div>
        }
        
        <div class="older-panels-container mt-4 w-full flex flex-col md:flex-row gap-5">

            <div class="panel-container lg:w-[65%] py-5">
                {
                    (responsePanels.length == 3 || (responsePanels.length > 0))
                        && 
                        <div class="wrapper flex justify-center items-center flex-wrap gap-7">
                        {
                            panelsList.slice(secondListStartIndex, allSiteFetch.siteData.siteHomePanelCount).map((panel: panelStructure, index:number) => (
                                <SMM_panelCardsNew
                                    lang ={lang}
                                    descriptionText={lang == "es" ? panel.panelMetaDescriptionES : panel.panelMetaDescriptionPT}
                                    imageSrc = {panel.panelFeaturedImage == null ? "" : panel.panelFeaturedImage }
                                    panelTitle={panel.panelTitle}
                                    slugURL={panel.panelSlug}
                                />
                            ))
                        }
                        </div>
                }
                {
                    (responsePanels.length > 3) &&
                        <span class="flex justify-center items-center w-full my-4">
                                <ButtonUI title={contentPath.text[11]} link={getRelativeLocaleUrl(lang,'panels')}></ButtonUI>
                        </span>
                }
            </div>
    
            <aside class="lg:w-[35%] py-5 flex flex-col gap-y-4">
               
                {
                    allSidebarWidgetsFetch.length > 0 &&
                    allSidebarWidgetsFetch.map((widget:any)=> (
                        
                        <div class="widget-container z-[1] rounded-md text-center" set:html={widget.widgetCodeBlock}></div>
                    ))
                }
    
            </aside>
            
        </div>
    </section>

</MainLayoutNew>
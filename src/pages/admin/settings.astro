    // Function to fetch Setting from API
    async function fetchSettingsData() {
        try {
            // Replace with your actual API endpoint
            const response = await fetch(APIUrl + `siteSettings/` + settingsID, {
                method: "GET",
                headers: {
                    'Content-Type': 'application/json',
                    "origin" : "http://localhost:4321",
                    // "x-api-key" : key
                },
            });
            const user = await response.json();
            console.log(user);

            document.getElementById("SiteTitle").value = user.siteData.SiteTitle || "";
            document.getElementById("SiteMetaDescription").value = user.siteData.SiteMetaDescription || "";
            document.getElementById("siteDeployHook").value = user.siteData.siteDeployHook || "";
            document.getElementById("newAdminToggle").checked = (user.siteData.isNewAdminAllowed ? true : false);
            if(user.siteData.SiteBGImage){

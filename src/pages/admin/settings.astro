            document.getElementById("panelPagePanelHeaderText").value = user.panelPageData.panelPagePanelHeaderText || "";
            document.getElementById("panelPagePanelSubText").value = user.panelPageData.panelPagePanelSubText || "";
            document.getElementById("panelPageReadMoreBtntext").value = user.panelPageData.panelPageReadMoreBtntext || "";
            
            document.getElementById("servicePagePanelHeaderText").value = user.servicePageData.servicePagePanelHeaderText || "";
            document.getElementById("servicePagePanelSubText").value = user.servicePageData.servicePagePanelSubText || "";
            
            document.getElementById("paymentOptionHeaderText").value = user.paymentOptionPageData.paymentOptionHeaderText || "";
            document.getElementById("paymentOptionSubText").value = user.paymentOptionPageData.paymentOptionSubText || "";
            
            if(user.emailData){
                document.getElementById("emailFrom").value = user.emailData.emailFrom || "";
                document.getElementById("emailSubject").value = user.emailData.emailSubject || "";
                // Email Content in Editor JS
                
                editor.isReady
                .then(() => editor.render({
                    time: Date.now(),
                    blocks: user.emailData.emailJs_Content || []
                }))
                .catch((err) => console.error("Render failed", err));
            }

            document.getElementById("footerText").value = user.footerNotes || "";
            if(user.siteData.logoImage){
                logoPreviewImg.src =  imagePath + user.siteData.logoImage;
                logoPreview.classList.remove("hidden");
                logoUploadContainer.classList.add("hidden");
            }
            if(user.siteData.faviconImage){
                faviconPreviewImg.src = imagePath +  user.siteData.faviconImage;
                faviconPreview.classList.remove("hidden");
                faviconUploadContainer.classList.add("hidden");
            }

            navLinks = user.navbarData.navLinks;
            document.getElementById("rightButtonTitle").value = user.navbarData.rightButtonTitle || "";
            document.getElementById("rightButtonLink").value = user.navbarData.rightButtonLink || "";
            document.getElementById("rightButtonClasses").value = user.navbarData.rightButtonClasses || "";
            
            document.getElementById("footerText").value = user.footerData.footerText || "";
            if(user.footerData.footer3rdCol_Content){
                editorFooter.isReady
                .then(() => editorFooter.render({
                    time: Date.now(),
                    blocks: user.footerData?.footer3rdCol_Content
                }))
                .catch((err) => console.error("Render failed", err));
            }
            footerLinks = user.footerData.footerLinks;
            socialLinks = user.footerData.socialLinks
            document.getElementById("footerCopyrightText").value = user.footerData.footerCopyrightText || "";

            renderNavLinks();
            renderFooterLinks();
            renderSocialLinks();

        } catch (error) {
            console.error('Error fetching users:', error);
        }
    }

    // Update User Data
    async function updateSettings(id, data) {
        const obj = Object.fromEntries(data.entries());
        // console.log(obj);
        
        const formDataObj = {
            siteData : {
                SiteTitle : obj.SiteTitle,
                SiteMetaDescription : obj.SiteMetaDescription,
                siteDeployHook : obj.siteDeployHook,
                SiteBGImage : "siteBgImg",
                logoImage : "siteLogo",
                faviconImage : "siteFavicon",
                siteHomePanelCount : parseInt(obj.siteHomePanelCount),
                sitePanelCount : parseInt(obj.sitePanelCount),
                isNewAdminAllowed : obj.newAdminToggle == "on" ? true : false,
            },
            homePageData : {
                homeHeaderTitle : obj.homeHeaderTitle,
                homeHeaderParagraph : obj.homeHeaderParagraph,
                homePagePanelHeaderText : obj.homePagePanelHeaderText,
                homePagePanelSubText : obj.homePagePanelSubText,
                homePagePanelButtonText : obj.homePagePanelButtonText,
                homeBackgroundImage : "HomeImg",
            },
            panelPageData : {
                panelPagePanelHeaderText : obj.panelPagePanelHeaderText,
                panelPagePanelSubText : obj.panelPagePanelSubText,
                panelPageReadMoreBtntext : obj.panelPageReadMoreBtntext,
            },
            servicePageData : {
                servicePagePanelHeaderText : obj.servicePagePanelHeaderText,
                servicePagePanelSubText : obj.servicePagePanelSubText,
            },
            paymentOptionPageData : {
                paymentOptionHeaderText : obj.paymentOptionHeaderText,
                paymentOptionSubText : obj.paymentOptionSubText,
            },
            navbarData : {
                navLinks,
                rightButtonTitle : obj.rightButtonTitle,
                rightButtonClasses : obj.rightButtonClasses,
                rightButtonLink : obj.rightButtonLink,
            },
            footerData : {
                footerText : obj.footerText,
                footerLinks,
                socialLinks,
                footer3rdCol_Content : JSON.parse(obj.footer3rdCol_Content),
                footerCopyrightText : obj.footerCopyrightText,
            },
            emailData : {
                emailFrom : obj.emailFrom,
                emailJs_Content : JSON.parse(obj.emailJs_Content),
                emailSubject : obj.emailSubject
            },
            MetaData : {
                //homeBackgroundImage
                //Es translations at API end
                //Pt translations at API end
            }
        }

        debugger
        if(LOGObase64String){
            formDataObj.MetaData.LOGObase64String = LOGObase64String;
            formDataObj.MetaData.LOGOfileType = LOGOfileType;
        }
        if(FAVICONbase64String){
            formDataObj.MetaData.FAVICONbase64String = FAVICONbase64String;
            formDataObj.MetaData.FAVICONfileType = FAVICONfileType;
        }
        if(SiteBgImgbase64String){
            formDataObj.MetaData.SiteBgbase64String = SiteBgImgbase64String;
            formDataObj.MetaData.SiteBgfileType = SiteBgImgfileType;
        }
        if(HomeImgbase64String){
            formDataObj.MetaData.HomeImgbase64String = HomeImgbase64String;
            formDataObj.MetaData.HomeImgfileType = HomeImgfileType;
        }
        
        if(LOGOisImageRemoved)
            formDataObj.MetaData.LOGOisImageRemoved = LOGOisImageRemoved;
        if(FAVICONisImageRemoved)
            formDataObj.MetaData.FAVICONisImageRemoved = FAVICONisImageRemoved;
        if(SiteBgImgisImageRemoved)
            formDataObj.MetaData.SiteBgImgisImageRemoved = SiteBgImgisImageRemoved;
        if(HomeImgisImageRemoved)
            formDataObj.MetaData.HomeImgisImageRemoved = HomeImgisImageRemoved;

        console.log(formDataObj);
        
        try {
            // Replace with your actual API endpoint
            const response = await fetch(APIUrl + `siteSettings/${id}`, {
                method: "PUT",
                headers: {
                    'Content-Type': 'application/json',
                    "origin" : "http://localhost:4321",
                    // "x-api-key" : key
                },
                body : JSON.stringify(formDataObj)
            });
            const users = await response.json();
            console.log(users);
            
            debugger
            if (response.ok && response.status === 200) {
                return "success"
            } else {
                return "failed"
            }

        } catch (error) {
            console.error('Error while updating user:', error);
        }
    }

    // Save settings button
    document.getElementById('save-settings').addEventListener('click', async function () {
        const form = document.getElementById('settings-form');
        const formData = new FormData(form);

        await editor.save().then(async (outputData) => {
            formData.append("emailJs_Content", JSON.stringify(outputData.blocks)
                .replaceAll("&nbsp;", " ")
                .replaceAll("  ", " ")
                .replaceAll("  ", " ")
            );
        })

        await editorFooter.save().then(async (outputData) => {
            formData.append("footer3rdCol_Content", JSON.stringify(outputData.blocks)
                .replaceAll("&nbsp;", " ")
                .replaceAll("  ", " ")
                .replaceAll("  ", " ")
            );
        })

        showLoadingModal()
        let originalText = "";
        setTimeout(() => {
            updateSettings(settingsID , formData).then(resp => {
                if (resp === 'success'){
                    toastSystem.show({
                        type: 'success',
                        title: 'Data updated',
                        message: `Profile information updated successfully`,
                        duration: 6000
                    });
                }
                else{
                    toastSystem.show({
                        type: 'error',
                        title: 'Error occured',
                        message: `An error occured while updating the user`,
                        duration: 6000
                    });
                }

                LOGOisImageRemoved = false;
                FAVICONisImageRemoved = false;
            });
            
            // Show loading state
            originalText = this.innerHTML;
            this.innerHTML = '<i class="fas fa-spinner fa-spin mr-2"></i> Saving...';
            this.disabled = true;
            modalSystem.closeAll();
        }, 1500);

         setTimeout(() => {
            this.innerHTML = originalText;
            this.disabled = false;
        }, 1500);
    })

    document.addEventListener('DOMContentLoaded', ()=>{
        fetchSettingsData()
    });
</script>